# Слушаем события в Telegram (с помощью webhook или polling)
def send_to_discord(message, topic):
    url = f'https://discord.com/api/webhooks/{DISCORD_TOKEN}/sendMessage'
    params = {
        'content': message,
    }
    response = requests.post(url, json=params)
    if response.status_code == 200:
        print(f"Message sent to Discord channel '{topic}' successfully.")
    else:
        print(f"Failed to send message to Discord. Status Code: {response.status_code}")
